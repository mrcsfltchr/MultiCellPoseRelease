#!/bin/bash
#PBS -N cpsam_diversity
#PBS -l select=1:ncpus=12:ngpus=1:mem=32gb
#PBS -l walltime=12:00:00
#PBS -koed

set -euo pipefail

REPO_DIR="${REPO_DIR:-$HOME/MultiCellPose-public}"
OOD_ROOT="${OOD_ROOT:-$HOME/cpsamOODtest}"
MCP_TEST_DIR="${MCP_TEST_DIR:-$HOME/MCP_paper/test}"
OUTPUT_ROOT="${OUTPUT_ROOT:-$HOME/MCP_paper/dataset_diversity_experiment}"
MODALITY_SPLIT_ROOT="${MODALITY_SPLIT_ROOT:-$HOME/MCP_paper/modality_encoder_block_sweep}"
SPLIT_BLOCK_DIR="${SPLIT_BLOCK_DIR:-blocks09}"
CONDA_ENV="${CONDA_ENV:-mcp_pub}"
CUDA_MODULE="${CUDA_MODULE:-cuda/12.1}"

MODALITIES="${MODALITIES:-Fluorescence Confocal PhaseContrast}"
MATCH_UNIT="${MATCH_UNIT:-objects}"
TRAIN_SIZES="${TRAIN_SIZES:-25 50 100 200}"
SEEDS="${SEEDS:-17 23 31}"

BASE_MODEL="${BASE_MODEL:-cpsam}"
MODEL_PREFIX="${MODEL_PREFIX:-guvpose_diversity}"
EPOCHS="${EPOCHS:-300}"
BATCH_SIZE="${BATCH_SIZE:-8}"
B_SIZE="${B_SIZE:-256}"
MAX_VAL_RECORDS="${MAX_VAL_RECORDS:-300}"
NIMG_PER_EPOCH="${NIMG_PER_EPOCH:-0}"
NPZ_MASK_CHANNEL="${NPZ_MASK_CHANNEL:-last}"
NPZ_CACHE_DIR="${NPZ_CACHE_DIR:-${TMPDIR:-$HOME/ephemeral}/cpsam_dataset_diversity_npz_cache}"
CHANNEL_SAMPLING_MODE="${CHANNEL_SAMPLING_MODE:-single-and-all}"
MAX_ALL_CHANNEL_COMBOS="${MAX_ALL_CHANNEL_COMBOS:-2}"
CHANNEL_SAMPLING_VAL="${CHANNEL_SAMPLING_VAL:-true}"
UNFREEZE_BLOCKS="${UNFREEZE_BLOCKS:-9}"
LEARNING_RATE="${LEARNING_RATE:-5e-5}"
WEIGHT_DECAY="${WEIGHT_DECAY:-0.1}"
SCALE_RANGE="${SCALE_RANGE:-0.5}"
SEG_LOSS_WEIGHT="${SEG_LOSS_WEIGHT:-0.1}"
VAL_RATIO="${VAL_RATIO:-0.1}"
TEST_RATIO="${TEST_RATIO:-0.1}"
EARLY_STOP="${EARLY_STOP:-true}"
EARLY_STOP_PATIENCE="${EARLY_STOP_PATIENCE:-5}"
EARLY_STOP_MIN_DELTA="${EARLY_STOP_MIN_DELTA:-0.0}"
EVAL_BATCH_SIZE="${EVAL_BATCH_SIZE:-8}"
EVAL_MAX_RECORDS="${EVAL_MAX_RECORDS:-0}"
IGNORE_CLASSES="${IGNORE_CLASSES:-true}"

cd "$REPO_DIR"

module load "$CUDA_MODULE" 2>/dev/null || true

if [ -x "$HOME/miniconda3/bin/conda" ]; then
    eval "$($HOME/miniconda3/bin/conda shell.bash hook)"
elif [ -x "$HOME/miniforge3/bin/conda" ]; then
    eval "$($HOME/miniforge3/bin/conda shell.bash hook)"
else
    echo "ERROR: conda not found in $HOME/miniconda3 or $HOME/miniforge3"
    exit 2
fi
conda activate "$CONDA_ENV"

export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-8}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"

mkdir -p "$OUTPUT_ROOT"
mkdir -p "$NPZ_CACHE_DIR"

if [ "$CHANNEL_SAMPLING_VAL" = "true" ] || [ "$CHANNEL_SAMPLING_VAL" = "1" ] || [ "$CHANNEL_SAMPLING_VAL" = "yes" ]; then
    CHANNEL_SAMPLING_VAL_FLAG="--channel-sampling-val"
else
    CHANNEL_SAMPLING_VAL_FLAG="--no-channel-sampling-val"
fi

EXTRA_FLAGS=()
if [ "$EARLY_STOP" = "true" ] || [ "$EARLY_STOP" = "1" ] || [ "$EARLY_STOP" = "yes" ]; then
    EXTRA_FLAGS+=("--early-stop")
fi
if [ "$IGNORE_CLASSES" = "true" ] || [ "$IGNORE_CLASSES" = "1" ] || [ "$IGNORE_CLASSES" = "yes" ]; then
    CLASS_FLAG="--ignore-classes"
else
    CLASS_FLAG="--no-ignore-classes"
fi

echo "Job ID: ${PBS_JOBID:-unknown}"
echo "Node: $(hostname)"
echo "Start: $(date)"
python -c "import torch; print('Torch:', torch.__version__); print('Torch CUDA:', torch.version.cuda); print('CUDA available:', torch.cuda.is_available()); print('GPU count:', torch.cuda.device_count())"
echo "REPO_DIR=$REPO_DIR"
echo "OOD_ROOT=$OOD_ROOT"
echo "MCP_TEST_DIR=$MCP_TEST_DIR"
echo "OUTPUT_ROOT=$OUTPUT_ROOT"
echo "MODALITY_SPLIT_ROOT=$MODALITY_SPLIT_ROOT"
echo "SPLIT_BLOCK_DIR=$SPLIT_BLOCK_DIR"
echo "CONDA_ENV=$CONDA_ENV"
echo "CUDA_MODULE=$CUDA_MODULE"
echo "MODALITIES=$MODALITIES"
echo "MATCH_UNIT=$MATCH_UNIT"
echo "TRAIN_SIZES=$TRAIN_SIZES"
echo "SEEDS=$SEEDS"
echo "BASE_MODEL=$BASE_MODEL"
echo "MODEL_PREFIX=$MODEL_PREFIX"
echo "EPOCHS=$EPOCHS"
echo "BATCH_SIZE=$BATCH_SIZE"
echo "B_SIZE=$B_SIZE"
echo "MAX_VAL_RECORDS=$MAX_VAL_RECORDS"
echo "NIMG_PER_EPOCH=$NIMG_PER_EPOCH"
echo "NPZ_MASK_CHANNEL=$NPZ_MASK_CHANNEL"
echo "NPZ_CACHE_DIR=$NPZ_CACHE_DIR"
echo "CHANNEL_SAMPLING_MODE=$CHANNEL_SAMPLING_MODE"
echo "MAX_ALL_CHANNEL_COMBOS=$MAX_ALL_CHANNEL_COMBOS"
echo "CHANNEL_SAMPLING_VAL=$CHANNEL_SAMPLING_VAL"
echo "UNFREEZE_BLOCKS=$UNFREEZE_BLOCKS"
echo "LEARNING_RATE=$LEARNING_RATE"
echo "EARLY_STOP=$EARLY_STOP"
echo "EARLY_STOP_PATIENCE=$EARLY_STOP_PATIENCE"
echo "EARLY_STOP_MIN_DELTA=$EARLY_STOP_MIN_DELTA"
echo "IGNORE_CLASSES=$IGNORE_CLASSES"

python "$REPO_DIR/tools/run_dataset_diversity_experiment.py" \
    --ood-root "$OOD_ROOT" \
    --mcp-test-dir "$MCP_TEST_DIR" \
    --output-root "$OUTPUT_ROOT" \
    --modalities $MODALITIES \
    --modality-split-root "$MODALITY_SPLIT_ROOT" \
    --split-block-dir "$SPLIT_BLOCK_DIR" \
    --match-unit "$MATCH_UNIT" \
    --train-sizes $TRAIN_SIZES \
    --seeds $SEEDS \
    --base-model "$BASE_MODEL" \
    --model-prefix "$MODEL_PREFIX" \
    --epochs "$EPOCHS" \
    --batch-size "$BATCH_SIZE" \
    --bsize "$B_SIZE" \
    --learning-rate "$LEARNING_RATE" \
    --weight-decay "$WEIGHT_DECAY" \
    --scale-range "$SCALE_RANGE" \
    --seg-loss-weight "$SEG_LOSS_WEIGHT" \
    --unfreeze-blocks "$UNFREEZE_BLOCKS" \
    --val-ratio "$VAL_RATIO" \
    --test-ratio "$TEST_RATIO" \
    --max-val-records "$MAX_VAL_RECORDS" \
    --nimg-per-epoch "$NIMG_PER_EPOCH" \
    --balance-mode source \
    --channel-sampling-mode "$CHANNEL_SAMPLING_MODE" \
    --max-all-channel-combos "$MAX_ALL_CHANNEL_COMBOS" \
    "$CHANNEL_SAMPLING_VAL_FLAG" \
    --npz-mask-channel "$NPZ_MASK_CHANNEL" \
    --npz-cache-dir "$NPZ_CACHE_DIR" \
    --early-stop-patience "$EARLY_STOP_PATIENCE" \
    --early-stop-min-delta "$EARLY_STOP_MIN_DELTA" \
    --eval-batch-size "$EVAL_BATCH_SIZE" \
    --eval-max-records "$EVAL_MAX_RECORDS" \
    "$CLASS_FLAG" \
    "${EXTRA_FLAGS[@]}"

echo "Finish: $(date)"
